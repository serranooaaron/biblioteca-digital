PORT=8081
# Cadena de conexión de MongoDB Atlas. Usa una base propia (ej. /biblioteca-digital) para no mezclar con la entrega.
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/biblioteca-digital
# Opcional: nombre de la base (por defecto biblioteca-digital). Va aparte de la cadena, así dos apps pueden compartir clúster.
DB_NAME=
# Clave para firmar los JWT: un texto largo y aleatorio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=
# Opcional: cuenta de administrador que crea `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
# Opcional: saltos de proxy delante de la app (en Render, 1) para que el límite de intentos de login vea la IP real.
TRUST_PROXY=
# Dirección pública del sitio, para los links de los emails (ej. https://biblioteca-digital-veah.onrender.com).
# En producción es obligatoria: el link nunca se arma con el encabezado Host del pedido.
APP_URL=
# Envío de emails con Brevo (recuperar contraseña). Sin clave, en desarrollo el email sale por consola.
BREVO_API_KEY=
# Remitente verificado en Brevo y nombre que ve quien recibe el email.
MAIL_FROM=
MAIL_FROM_NAME=Biblioteca Digital
