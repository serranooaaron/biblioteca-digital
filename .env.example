PORT=8081
# Cadena de conexión de MongoDB Atlas. Usa una base propia (ej. /biblioteca-digital) para no mezclar con la entrega.
MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/biblioteca-digital
# Clave para firmar los JWT: un texto largo y aleatorio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=
# Opcional: cuenta de administrador que crea `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
